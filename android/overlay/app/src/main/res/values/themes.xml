<resources>
    <!--
      Sistem çubukları saydam; güvenli alan CSS env() ile yönetilir.

      Üst tema MUTLAKA AppCompat (veya türevi) olmalı: Tauri'nin WryActivity
      sınıfı AppCompatActivity'ten türer ve AppCompat onCreate içinde temayı
      doğrular. android:style/Theme.Material.* ile uygulama açılışta
      "You need to use a Theme.AppCompat theme" istisnasıyla kapanır.
    -->
    <style name="Theme.DosyaDolabi" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/dod_paper</item>
        <item name="android:colorAccent">@color/dod_accent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
